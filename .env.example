# LinguaRead environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# Full reference for every variable: SETTINGS.md
#
# In CI/CD deployments this file's contents live in the per-environment
# GitHub secret `DOTENV` (Settings -> Environments -> staging / production).

# ── 1. PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=linguaread_db
POSTGRES_USER=linguaread_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ── 2. JWT authentication ────────────────────────────────────────────────────
# JWT_KEY must be a random string of at least 32 characters.
# Generate one:  openssl rand -base64 32
JWT_KEY="replace_this_with_your_very_long_and_secure_random_jwt_key"
# Issuer/audience are opaque labels, not URLs — they never need to follow the site's
# domain. Default to LinguaReadApi / LinguaReadClient when unset; changing either
# logs everyone out.
#JWT_ISSUER=LinguaReadApi
#JWT_AUDIENCE=LinguaReadClient
# Token lifetime in hours (default 2160 = 90 days)
#JWT_EXPIRY_HOURS=2160

# ── 3. Initial login password (optional) ─────────────────────────────────────
# Sets the default user's password on first startup; otherwise use the in-app setup page.
LINGUAREAD_PASSWORD=

# ── 4. Third-party API keys (optional; blank disables the feature) ───────────
DEEPL_API_KEY=
GEMINI_API_KEY=
# Wikimedia OAuth token — raises Wiktionary lookup rate limits (optional)
#WIKTIONARY_ACCESS_TOKEN=
# Server-level fallback keys for Azure Translator / Google Translate (optional;
# per-user keys set in the app's Settings page take precedence)
#AZURE_TRANSLATOR_KEY=
#AZURE_TRANSLATOR_REGION=
#GOOGLE_TRANSLATE_API_KEY=

# ── 5. Networking ────────────────────────────────────────────────────────────
# Only for OTHER origins calling the API. The site itself is served same-origin by
# nginx and needs no entry here, so a domain move doesn't touch this.
# Comma-separated, e.g. https://other-app.example.com. Blank = deny cross-origin.
CORS_ALLOWED_ORIGINS=

# ── 6. Discord weekly reports (optional) ─────────────────────────────────────
#DISCORD_WEEKLY_REPORT_DAY=Monday
#DISCORD_WEEKLY_REPORT_HOUR_UTC=8
#DISCORD_WEEKLY_REPORT_DRY_RUN=false
#DISCORD_WEEKLY_REPORT_POLL_MINUTES=30

# ── 7. Backup sidecar heartbeat (optional) ───────────────────────────────────
# healthchecks.io-style ping URL; backup.sh pings it on start/success/failure.
# Create a check with ~26h grace for the nightly 02:00 job. Empty = disabled.
#HEALTHCHECK_URL=

# ── 8. Set by the deploy workflow — don't put these in DOTENV ───────────────
# Image tags are pinned to the immutable sha-<short7> tag, and BACKUP_ENV (the
# per-environment Google Drive folder) to the GitHub environment name.
#BACKUP_ENV=production
#API_IMAGE_TAG=latest
#NGINX_IMAGE_TAG=latest
#BACKUP_IMAGE_TAG=latest

# ── 9. Host sizing (optional) ────────────────────────────────────────────────
# Defaults fit a ~4 GB host. A deployed host takes these from its GitHub
# environment's variables of the same name (the deploy appends them); set them
# here only for a stack you run by hand. Postgres: ~25% / ~50% of RAM.
#POSTGRES_SHARED_BUFFERS=1GB
#POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
# API memory + swap (prod overlay). Equal to its 1500M limit = no swap for the API;
# raise it (e.g. 3000M) on a host with less RAM than that limit.
#API_MEMSWAP_LIMIT=1500M
