# Shell scripts run on Linux hosts and in containers; a CRLF checkout (core.autocrlf=true
# on Windows) breaks them the moment one is copied or bind-mounted from a working tree.
*.sh text eol=lf
# Copied into the backup image; supercronic would run "/backup.sh\r" from a CRLF line.
backup/crontab text eol=lf

# The pinned dictionary hash must survive Windows checkouts unchanged.
server/LinguaReadApi/Resources/Segmentation/jieba-big-v1.txt -text
server/LinguaReadApi/Resources/Segmentation/words_th.txt -text
# Shared golden fixtures must have identical bytes in both runtimes.
tests/golden/*.json text eol=lf
# KRDICT checksums are pinned across independent server/browser build contexts.
resources/krdict_lemmas.txt -text
server/LinguaReadApi/Resources/Korean/krdict_lemmas.txt -text
client/lingua-read-client/src/resources/krdict_lemmas.txt -text
